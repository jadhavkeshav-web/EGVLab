<script>
(function(){
  "use strict";
  // This page is normally shown inside index.html; the buttons ask that page to switch topics or start the tour.
  // (By message, not by reaching into the page: that also works when the site is opened straight from the disk.)
  var framed = window.parent !== window;
  function goTopic(id){ if (framed) window.parent.postMessage({ egt:1, cmd:"go", id:id }, "*"); else location.href = "index.html#" + id; }
  function startTour(){ if (framed) window.parent.postMessage({ egt:1, cmd:"tour" }, "*"); else location.href = "index.html#tour"; }

  Array.prototype.forEach.call(document.querySelectorAll("[data-topic]"), function(b){
    b.addEventListener("click", function(){ goTopic(b.getAttribute("data-topic")); });
  });
  document.getElementById("how-btn").addEventListener("click", startTour);
  document.getElementById("tour-btn-2").addEventListener("click", startTour);

  // ---- optional accounts + public usage summary (only once the account server is set up) ----
  (function(){
    var EG = window.EG;
    if (!EG || !EG.apiBase()) return;
    document.getElementById("track").hidden = false;
    var sess = EG.session(), me = document.getElementById("me-line");
    if (sess && sess.role) {
      me.hidden = false;
      me.textContent = "You are logged in as " + sess.name + " (" + sess.role + ")." +
        (sess.role === "student" ? " Your progress is being recorded for your faculty." : "");
      document.getElementById("acct-btn").hidden = true;
      document.getElementById("dash-btn").hidden = sess.role !== "faculty";
    } else if (sess) {
      document.getElementById("acct-btn").textContent = "Finish signing up";
    }

    var NAMES = { curves:"Engineering Curves", lines:"Projection of Lines", orthographic:"Orthographic Projection",
                  isometric:"Isometric View", development:"Development of Surfaces" };
    function fmt(n){ return (n || 0).toLocaleString("en-IN"); }
    function plural(n, one, many){ return fmt(n) + " " + (n === 1 ? one : many); }
    function set(id, v){ document.getElementById(id).textContent = v; }
    EG.apiFetch("/home_summary.php", { noAuth: true }).then(function(d){
      if (!d || !d.ok) return;                      // server unreachable: leave the panel hidden
      set("u-users", fmt(d.faculty + d.students));
      set("u-split", plural(d.faculty, "faculty member", "faculty members") + " · " + plural(d.students, "student", "students"));
      set("u-inst", fmt(d.institutes));
      set("u-opened", fmt(d.problems_opened));
      set("u-done", fmt(d.problems_completed));
      set("u-anon", fmt(d.anon_opens));
      var regMins = d.minutes_spent || 0, anonMins = d.anon_minutes_spent || 0, mins = regMins + anonMins;
      if (mins < 120) { set("u-hours", fmt(mins)); set("u-hours-l", "minutes of practice"); }
      else set("u-hours", fmt(Math.round(mins / 60)));
      set("u-hours-split", anonMins ? plural(anonMins, "minute", "minutes") + " of that from visits with no account" : "");
      var apps = d.apps || {}, max = 0, host = document.getElementById("u-bars");
      Object.keys(NAMES).forEach(function(k){ max = Math.max(max, (apps[k] || {}).completed || 0); });
      host.innerHTML = "";
      Object.keys(NAMES).forEach(function(k){
        var a = apps[k] || { completed:0, minutes:0, anon_minutes:0 };
        var totalMin = (a.minutes || 0) + (a.anon_minutes || 0);
        var row = document.createElement("div"); row.className = "bar";
        var top = document.createElement("div"); top.className = "bar-top";
        var name = document.createElement("span"); name.textContent = NAMES[k];
        var num = document.createElement("em");
        num.textContent = fmt(a.completed) + " · " + (totalMin >= 120 ? fmt(Math.round(totalMin / 60)) + " h" : fmt(totalMin) + " min");
        top.appendChild(name); top.appendChild(num);
        var track = document.createElement("div"); track.className = "bar-track";
        var fill = document.createElement("div"); fill.className = "bar-fill";
        fill.style.width = (max ? Math.round(100 * a.completed / max) : 0) + "%";
        track.appendChild(fill); row.appendChild(top); row.appendChild(track); host.appendChild(row);
      });
      document.getElementById("usage").hidden = false;
    });
  })();

  // ---- hero picture: a circle rolls along the line and its point P traces the cycloid ----
  var R = 50, X0 = 23, BASE = 130, CY = BASE - R, TWO_PI = Math.PI * 2;
  function P(th){ return [X0 + R * (th - Math.sin(th)), BASE - R * (1 - Math.cos(th))]; }
  function path(th){ var d = "", n = Math.max(2, Math.round(th / 0.04));
    for (var i = 0; i <= n; i++){ var p = P(th * i / n); d += (i ? "L" : "M") + p[0].toFixed(1) + " " + p[1].toFixed(1); } return d; }
  var el = function(id){ return document.getElementById(id); };
  el("cyc-full").setAttribute("d", path(TWO_PI));
  function frame(th){
    var cx = X0 + R * th, p = P(th);
    el("roll").setAttribute("cx", cx); el("roll").setAttribute("cy", CY);
    el("hub").setAttribute("cx", cx);  el("hub").setAttribute("cy", CY);
    el("spoke").setAttribute("x1", cx); el("spoke").setAttribute("y1", CY);
    el("spoke").setAttribute("x2", p[0]); el("spoke").setAttribute("y2", p[1]);
    el("pt").setAttribute("cx", p[0]); el("pt").setAttribute("cy", p[1]);
    el("cyc-done").setAttribute("d", path(th));
  }
  var still = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (still) { frame(TWO_PI); return; }
  var RUN = 6500, HOLD = 1400, t0 = null;
  function tick(now){
    if (t0 === null) t0 = now;
    var t = (now - t0) % (RUN + HOLD);
    frame(TWO_PI * Math.min(1, t / RUN));
    requestAnimationFrame(tick);
  }
  frame(0);
  requestAnimationFrame(tick);
})();
</script>
</body>
</html>
